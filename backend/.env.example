# =============================================================================
# FullBikers API - plantilla de variables de entorno
# -----------------------------------------------------------------------------
# Copiar como backend/.env (excluido de Git) y completar los valores.
# NUNCA escribir aquí ni en ningún archivo versionado valores reales.
# En producción (Render) estas variables se configuran en el panel del servicio.
# =============================================================================

# Entorno de ejecución: development | testing | production
APP_ENV=development

# Clave de firma de Flask (sesiones, utilidades firmadas).
# En producción es OBLIGATORIA: mínimo 32 caracteres aleatorios.
# Generar con:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# En desarrollo, si se deja vacía, se genera una aleatoria en cada arranque.
SECRET_KEY=

# Clave de firma de los tokens JWT (Flask-JWT-Extended, etapa de autenticación).
# Mismas reglas que SECRET_KEY y DEBE ser distinta de ella.
JWT_SECRET_KEY=

# Cadena de conexión a PostgreSQL (Neon), rama "development", rol fullbikers_app.
# Usar el endpoint DIRECTO (sin "-pooler" en el host): la API ya tiene su pool.
# Formato (los valores entre <> son marcadores, no datos reales):
#   postgresql://fullbikers_app:<contraseña>@<host-directo>.neon.tech/fullbikers?sslmode=require&channel_binding=require
# Si se deja vacía, la API arranca, /api/health responde y los endpoints que
# usan la base devuelven 503.
DATABASE_URL=

# Orígenes permitidos por CORS, separados por comas (sin "/" final).
# Desarrollo: servidor de Vite. Producción: URL de Netlify. "*" no se admite en producción.
CORS_ORIGINS=http://localhost:5173

# Pool de conexiones de Psycopg (por proceso de la API).
# MIN=0: no se mantienen conexiones abiertas en reposo, lo que permite que la
# instancia de Neon se suspenda cuando no hay tráfico (ahorra horas de cómputo).
# Las conexiones inactivas se cierran tras 5 minutos.
DB_POOL_MIN_SIZE=0
DB_POOL_MAX_SIZE=5

# Segundos máximos para establecer una conexión o para obtenerla del pool.
DB_CONNECT_TIMEOUT=10

# Puerto HTTP. Lo usan "python app.py" en local y Gunicorn en Render
# (Render define PORT automáticamente). "flask run" usa 5000 salvo --port.
PORT=5000

# Nivel de logging: DEBUG | INFO | WARNING | ERROR (predeterminado: INFO)
LOG_LEVEL=INFO
